/* pages/home/home.wxss */
.header {
  text-align: center;
  padding: 80rpx 40rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: white;
  margin: -40rpx -40rpx 60rpx -40rpx;
  border-radius: 0 0 60rpx 60rpx;
}

.header-title {
  font-size: 56rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.header-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1e293b;
}

.text-secondary {
  color: #64748b;
  font-size: 28rpx;
  line-height: 1.8;
}

.mb-32 {
  margin-bottom: 32rpx;
}

.feature-list {
  margin-bottom: 48rpx;
}

.feature-item {
  margin-bottom: 24rpx;
  font-size: 28rpx;
  color: #1e293b;
}

.feature-item text {
  font-weight: 600;
  color: #6366f1;
  margin-right: 8rpx;
}

.error {
  background: #fef2f2;
  color: #ef4444;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  font-size: 28rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 48rpx;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.btn-primary {
  background: #6366f1;
  color: white;
}

.btn-primary:active {
  background: #4f46e5;
}

.btn:disabled {
  opacity: 0.6;
}
